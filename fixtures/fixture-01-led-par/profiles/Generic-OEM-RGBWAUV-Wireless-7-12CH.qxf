<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5.2.2</Version>
  <Author>dmx-fixture-research</Author>
 </Creator>
 <Manufacturer>dmx-fixture-research</Manufacturer>
 <Model>RGBWAUV Wireless PAR 7CH-12CH</Model>
 <Type>Color Changer</Type>
 <Channel Name="Red" Preset="IntensityRed"/>
 <Channel Name="Green" Preset="IntensityGreen"/>
 <Channel Name="Blue" Preset="IntensityBlue"/>
 <Channel Name="Amber" Preset="IntensityAmber"/>
 <Channel Name="White" Preset="IntensityWhite"/>
 <Channel Name="UV" Preset="IntensityUV"/>
 <Channel Name="7CH Strobe Effect">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="15" Preset="ShutterOpen">Open / static light</Capability>
  <Capability Min="16" Max="131" Preset="StrobeSlowToFast">Strobe slow to fast</Capability>
  <Capability Min="132" Max="189" Preset="PulseSlowToFast">Pulse / fade bright to dark</Capability>
  <Capability Min="190" Max="230" Preset="PulseSlowToFast">Pulse / fade dark to bright</Capability>
  <Capability Min="231" Max="255" Preset="ShutterOpen">Open / max brightness</Capability>
 </Channel>
 <Channel Name="Color Presets">
  <Group Byte="0">Colour</Group>
  <Capability Min="0" Max="10">No function</Capability>
  <Capability Min="11" Max="40">Color preset 1</Capability>
  <Capability Min="41" Max="70">Color preset 2</Capability>
  <Capability Min="71" Max="100">Color preset 3</Capability>
  <Capability Min="101" Max="130">Color preset 4</Capability>
  <Capability Min="131" Max="160">Color preset 5</Capability>
  <Capability Min="161" Max="190">Color preset 6</Capability>
  <Capability Min="191" Max="220">Color preset 7</Capability>
  <Capability Min="221" Max="255">Color preset / white balance</Capability>
 </Channel>
 <Channel Name="Master Dimmer" Preset="IntensityMasterDimmer"/>
 <Channel Name="12CH Strobe Effect">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="7">Blackout</Capability>
  <Capability Min="8" Max="15">Open</Capability>
  <Capability Min="16" Max="131">Strobe slow to fast</Capability>
  <Capability Min="132" Max="139">Open</Capability>
  <Capability Min="140" Max="181">Pulse - slow close, fast open</Capability>
  <Capability Min="182" Max="189">Open</Capability>
  <Capability Min="190" Max="231">Pulse - slow open, fast close</Capability>
  <Capability Min="232" Max="239">Open</Capability>
  <Capability Min="240" Max="247">Random strobe</Capability>
  <Capability Min="248" Max="255">Open</Capability>
 </Channel>
 <Channel Name="Random Color Change">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="10">No function</Capability>
  <Capability Min="11" Max="255">Random color change slow to fast</Capability>
 </Channel>
 <Channel Name="Auto Color Change">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="10">No function</Capability>
  <Capability Min="11" Max="255">Auto color change slow to fast</Capability>
 </Channel>
 <Channel Name="Auto Sound Strobe">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="10">No function</Capability>
  <Capability Min="11" Max="120">Auto / sound program</Capability>
  <Capability Min="121" Max="255">Auto / sound / strobe program</Capability>
 </Channel>
 <Mode Name="7 Channel  - probable Rasha/OEM">
  <Channel Number="0">Red</Channel>
  <Channel Number="1">Green</Channel>
  <Channel Number="2">Blue</Channel>
  <Channel Number="3">White</Channel>
  <Channel Number="4">Amber</Channel>
  <Channel Number="5">UV</Channel>
  <Channel Number="6">7CH Strobe Effect</Channel>
 </Mode>
 <Mode Name="12 Channel - probable Rasha/OEM">
  <Channel Number="0">Red</Channel>
  <Channel Number="1">Green</Channel>
  <Channel Number="2">Blue</Channel>
  <Channel Number="3">Amber</Channel>
  <Channel Number="4">White</Channel>
  <Channel Number="5">UV</Channel>
  <Channel Number="6">Color Presets</Channel>
  <Channel Number="7">Master Dimmer</Channel>
  <Channel Number="8">12CH Strobe Effect</Channel>
  <Channel Number="9">Random Color Change</Channel>
  <Channel Number="10">Auto Color Change</Channel>
  <Channel Number="11">Auto Sound Strobe</Channel>
 </Mode>
 <Physical>
  <Bulb Type="LED" Lumens="0" ColourTemperature="0"/>
  <Dimensions Weight="1" Width="220" Height="220" Depth="90"/>
  <Lens Name="Fresnel" DegreesMin="25" DegreesMax="40"/>
  <Focus Type="Fixed" PanMax="0" TiltMax="0"/>
  <Technical PowerConsumption="90" DmxConnector="3-pin"/>
 </Physical>
</FixtureDefinition>
